# 本地裸跑后端（不通过 Docker）时使用。
# 复制本文件为 backend/.env 并填写；DotenvEnvironmentPostProcessor 会在启动时读取，
# 优先级：真实环境变量 > .env 文件 > application.yml 默认值。
# Docker 部署无需此文件（由 docker-compose 注入环境变量）。

# ===== 数据库（本地裸跑指向宿主机 3306）=====
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/musicPlayer?serverTimezone=GMT%2B8&characterEncoding=utf-8
MYSQL_USER=music_app
# Use MYSQL_APP_PASSWORD from the root .env when connecting to Compose MySQL
MYSQL_PASSWORD=

# ===== JWT 密钥（至少 32 字节，可用 `openssl rand -hex 32` 生成）=====
JWT_SECRET=

# ===== 文件上传路径（本地裸跑用项目根目录的 static/）=====
SONG_UPLOAD_PATH=../static/songs/
SONG_COVER_UPLOAD_PATH=../static/song_covers/
PLAYLIST_COVER_UPLOAD_PATH=../static/playlist_covers/
USER_COVER_UPLOAD_PATH=../static/user_covers/

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kyf.mp.server.modules.agent.mapper.AgentMapper$innerUserMapper">
    <resultMap id="UsersVO" type="com.kyf.mp.server.modules.agent.vo.GetUsersVO">
        <id property="id" column="user_id" />
        <result property="userName" column="user_name" />
    </resultMap>
    <select id="getUsers" resultMap="UsersVO"> select u.id as user_id, u.user_name as user_name from
        users as u where u.user_name like "%#{keyword}%" from users; </select>

</mapper>
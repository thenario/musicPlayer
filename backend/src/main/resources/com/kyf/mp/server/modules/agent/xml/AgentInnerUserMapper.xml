<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kyf.mp.server.modules.agent.mapper.AgentMapper$InnerUserMapper">
    <resultMap id="UsersDTO" type="com.kyf.mp.server.modules.agent.dto.GetUsersDTO">
        <id property="id" column="user_id" />
        <result property="userName" column="user_name" />
    </resultMap>
    <select id="getUsers" resultMap="UsersDTO">
        SELECT u.user_id, u.user_name
        FROM users u
        WHERE u.user_name LIKE CONCAT('%', #{keyword}, '%')
        ORDER BY u.user_id
    </select>
</mapper>
